<% content_for :title, @product.sku %>

<%= render "shared/page_header", title: "#{@product.sku} — #{@product.name}",
      subtitle: @product.description,
      actions: (policy(@product).update? ? link_to("Editar", edit_product_path(@product.sku), class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm hover:bg-slate-50") : nil) %>

<div class="grid gap-4 sm:grid-cols-4">
  <%= render "shared/stat_card", label: "En mano", value: @product.total_on_hand %>
  <%= render "shared/stat_card", label: "Reservado", value: @product.total_reserved %>
  <%= render "shared/stat_card", label: "Disponible", value: @product.total_available %>
  <%= render "shared/stat_card", label: "Margen", value: money(@product.margin),
        hint: "#{(@product.margin_ratio * 100).round(1)}%" %>
</div>

<section class="mt-8 rounded-xl border border-slate-200 bg-white">
  <header class="border-b border-slate-200 px-4 py-3"><h2 class="text-sm font-semibold">Existencias por depósito</h2></header>
  <% if @stock_items.empty? %>
    <p class="px-4 py-8 text-center text-sm text-slate-500">Este producto no tiene stock en ningún depósito.</p>
  <% else %>
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="px-4 py-2">Depósito</th><th class="px-4 py-2 text-right">En mano</th>
          <th class="px-4 py-2 text-right">Reservado</th><th class="px-4 py-2 text-right">Disponible</th>
          <th class="px-4 py-2 text-right">Reorden</th><th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @stock_items.each do |item| %>
          <tr>
            <td class="px-4 py-2 font-medium"><%= item.warehouse.code %></td>
            <td class="px-4 py-2 text-right font-mono"><%= item.quantity_on_hand %></td>
            <td class="px-4 py-2 text-right font-mono text-slate-500"><%= item.quantity_reserved %></td>
            <td class="px-4 py-2 text-right font-mono <%= stock_level_class(item) %>"><%= item.quantity_available %></td>
            <td class="px-4 py-2 text-right font-mono text-slate-400"><%= item.reorder_point %></td>
            <td class="px-4 py-2 text-right">
              <%= link_to "Operar", stock_item_path(item), class: "text-xs text-slate-500 hover:text-slate-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>

<section class="mt-6 rounded-xl border border-slate-200 bg-white">
  <header class="border-b border-slate-200 px-4 py-3"><h2 class="text-sm font-semibold">Movimientos recientes</h2></header>
  <%= render "stock_movements/table", movements: @movements %>
</section>
