<% content_for :title, @transfer.reference %>
<%= render "shared/page_header", title: @transfer.reference,
      subtitle: "#{@transfer.source_warehouse.code} → #{@transfer.destination_warehouse.code}" %>

<div class="mb-4 flex items-center gap-3">
  <%= status_badge(@transfer.status) %>
  <% if @transfer.shrinkage.positive? %>
    <span class="rounded-full bg-rose-100 px-2 py-0.5 text-xs font-medium text-rose-800">
      Merma: <%= @transfer.shrinkage %> unidades
    </span>
  <% end %>
</div>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
      <tr><th class="px-4 py-2">SKU</th><th class="px-4 py-2">Producto</th>
      <th class="px-4 py-2 text-right">Solicitado</th><th class="px-4 py-2 text-right">Despachado</th>
      <th class="px-4 py-2 text-right">Recibido</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @transfer.lines.each do |line| %>
        <tr>
          <td class="px-4 py-2 font-mono"><%= line.product.sku %></td>
          <td class="px-4 py-2"><%= line.product.name %></td>
          <td class="px-4 py-2 text-right font-mono"><%= line.quantity_requested %></td>
          <td class="px-4 py-2 text-right font-mono"><%= line.quantity_dispatched %></td>
          <td class="px-4 py-2 text-right font-mono"><%= line.quantity_received %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-4 flex gap-2">
  <% if policy(@transfer).dispatch? %>
    <%= button_to "Despachar", dispatch_stock_transfer_path(@transfer),
          class: "rounded-md bg-amber-600 px-4 py-2 text-sm font-medium text-white hover:bg-amber-700" %>
  <% end %>
  <% if policy(@transfer).receive? %>
    <%= button_to "Recibir completa", receive_stock_transfer_path(@transfer),
          class: "rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700" %>
  <% end %>
</div>
