<% content_for :title, "Panel — Control de Stock" %>

<%= render "shared/page_header", title: "Panel de control",
      subtitle: "Estado general del inventario" %>

<div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
  <%= render "shared/stat_card", label: "Productos activos", value: number_with_delimiter(@stats[:products]) %>
  <%= render "shared/stat_card", label: "Unidades en stock", value: number_with_delimiter(@stats[:total_units]) %>
  <%= render "shared/stat_card", label: "Unidades reservadas", value: number_with_delimiter(@stats[:reserved_units]),
        hint: "no disponibles para vender" %>
  <%= render "shared/stat_card", label: "Bajo punto de reorden", value: @stats[:low_stock_count],
        tone: @stats[:low_stock_count].positive? ? "text-amber-600" : "text-slate-900" %>
  <%= render "shared/stat_card", label: "Depósitos", value: @stats[:warehouses] %>
  <%= render "shared/stat_card", label: "Transferencias abiertas", value: @stats[:open_transfers] %>
  <%= render "shared/stat_card", label: "Movimientos hoy", value: number_with_delimiter(@stats[:movements_today]) %>
  <%= render "shared/stat_card", label: "Eventos sin publicar", value: @stats[:pending_events],
        tone: @stats[:pending_events] > 100 ? "text-rose-600" : "text-slate-900",
        hint: "cola del outbox" %>
</div>

<div class="mt-8 grid gap-6 lg:grid-cols-2">
  <section class="rounded-xl border border-slate-200 bg-white">
    <header class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
      <h2 class="text-sm font-semibold">Necesita reposición</h2>
      <%= link_to "Ver todo", low_stock_stock_items_path, class: "text-xs text-slate-500 hover:text-slate-900" %>
    </header>
    <% if @low_stock.empty? %>
      <p class="px-4 py-8 text-center text-sm text-slate-500">Todo por encima del punto de reorden. 👌</p>
    <% else %>
      <ul class="divide-y divide-slate-100">
        <% @low_stock.each do |item| %>
          <li class="flex items-center justify-between px-4 py-3 text-sm">
            <div>
              <%= link_to item.product.sku, stock_item_path(item), class: "font-medium hover:underline" %>
              <span class="text-slate-500"><%= truncate(item.product.name, length: 40) %></span>
              <div class="text-xs text-slate-400"><%= item.warehouse.code %></div>
            </div>
            <div class="text-right">
              <div class="<%= stock_level_class(item) %>"><%= item.quantity_available %></div>
              <div class="text-xs text-slate-400">reorden: <%= item.reorder_point %></div>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white">
    <header class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
      <h2 class="text-sm font-semibold">Últimos movimientos</h2>
      <%= link_to "Ver todo", stock_movements_path, class: "text-xs text-slate-500 hover:text-slate-900" %>
    </header>
    <% if @recent_movements.empty? %>
      <p class="px-4 py-8 text-center text-sm text-slate-500">Sin movimientos todavía.</p>
    <% else %>
      <ul class="divide-y divide-slate-100">
        <% @recent_movements.each do |m| %>
          <li class="flex items-center justify-between px-4 py-2.5 text-sm">
            <div class="flex items-center gap-2">
              <%= movement_badge(m.kind) %>
              <span class="font-medium"><%= m.product.sku %></span>
              <span class="text-xs text-slate-400"><%= m.warehouse.code %></span>
            </div>
            <div class="flex items-center gap-3">
              <%= signed_quantity(m.quantity) %>
              <span class="text-xs text-slate-400"><%= time_ago_in_words(m.occurred_at) %></span>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
