<% content_for :title, "Existencias" %>
<%= render "shared/page_header", title: "Existencias",
      subtitle: "#{number_with_delimiter(@pagy.count)} combinaciones producto/depósito" %>

<div class="mb-4 flex gap-2">
  <%= link_to "Todas", stock_items_path,
        class: "rounded-md px-3 py-1.5 text-sm #{current_page?(stock_items_path) ? 'bg-slate-900 text-white' : 'border border-slate-300 bg-white'}" %>
  <%= link_to "Bajo punto de reorden", low_stock_stock_items_path,
        class: "rounded-md px-3 py-1.5 text-sm #{current_page?(low_stock_stock_items_path) ? 'bg-slate-900 text-white' : 'border border-slate-300 bg-white'}" %>
</div>

<% if @stock_items.empty? %>
  <%= render "shared/empty", message: "No hay existencias que mostrar." %>
<% else %>
  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="px-4 py-2">SKU</th><th class="px-4 py-2">Producto</th>
          <th class="px-4 py-2">Depósito</th><th class="px-4 py-2 text-right">En mano</th>
          <th class="px-4 py-2 text-right">Reservado</th><th class="px-4 py-2 text-right">Disponible</th>
          <th class="px-4 py-2 text-right">Reorden</th><th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @stock_items.each do |item| %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-2 font-mono"><%= item.product.sku %></td>
            <td class="px-4 py-2"><%= truncate(item.product.name, length: 40) %></td>
            <td class="px-4 py-2 text-slate-500"><%= item.warehouse.code %></td>
            <td class="px-4 py-2 text-right font-mono"><%= item.quantity_on_hand %></td>
            <td class="px-4 py-2 text-right font-mono text-slate-500"><%= item.quantity_reserved %></td>
            <td class="px-4 py-2 text-right font-mono <%= stock_level_class(item) %>"><%= item.quantity_available %></td>
            <td class="px-4 py-2 text-right font-mono text-slate-400"><%= item.reorder_point %></td>
            <td class="px-4 py-2 text-right">
              <%= link_to "Operar", stock_item_path(item), class: "text-xs text-slate-500 hover:text-slate-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="mt-4"><%== pagy_nav(@pagy) %></div>
<% end %>
