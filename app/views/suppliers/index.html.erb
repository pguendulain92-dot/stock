<% content_for :title, "Proveedores" %>
<%= render "shared/page_header", title: "Proveedores",
      actions: (policy(Supplier).create? ? link_to("Nuevo proveedor", new_supplier_path, class: "rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700") : nil) %>

<%= form_with url: suppliers_path, method: :get, class: "mb-4" do |f| %>
  <%= f.search_field :q, value: params[:q], placeholder: "Buscar por nombre o CUIT…",
        class: "w-full max-w-md rounded-md border-slate-300 text-sm shadow-sm" %>
<% end %>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
      <tr><th class="px-4 py-2">Nombre</th><th class="px-4 py-2">CUIT/Tax ID</th>
      <th class="px-4 py-2">Email</th><th class="px-4 py-2 text-right">Lead time</th><th class="px-4 py-2">Estado</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @suppliers.each do |s| %>
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-2"><%= link_to s.name, supplier_path(s), class: "font-medium hover:underline" %></td>
          <td class="px-4 py-2 font-mono text-slate-500"><%= s.tax_id %></td>
          <td class="px-4 py-2 text-slate-500"><%= s.email %></td>
          <td class="px-4 py-2 text-right"><%= s.default_lead_time_days %> días</td>
          <td class="px-4 py-2"><%= status_badge(s.active? ? "received" : "cancelled") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class="mt-4"><%== pagy_nav(@pagy) %></div>
