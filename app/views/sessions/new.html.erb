<% content_for :title, "Ingresar" %>
<div class="mx-auto mt-16 max-w-sm">
  <div class="rounded-xl border border-slate-200 bg-white p-8">
    <h1 class="text-xl font-semibold">📦 Control de Stock</h1>
    <p class="mt-1 text-sm text-slate-500">Ingresá con tu cuenta para continuar.</p>

    <%= form_with url: session_path, class: "mt-6 space-y-4" do |f| %>
      <div>
        <%= f.label :email_address, "Email", class: "block text-sm font-medium" %>
        <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              class: "mt-1 w-full rounded-md border-slate-300 text-sm shadow-sm" %>
      </div>
      <div>
        <%= f.label :password, "Contraseña", class: "block text-sm font-medium" %>
        <%= f.password_field :password, required: true, autocomplete: "current-password",
              class: "mt-1 w-full rounded-md border-slate-300 text-sm shadow-sm" %>
      </div>
      <%= f.submit "Ingresar", class: "w-full rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
    <% end %>

    <p class="mt-4 text-center text-xs text-slate-400">
      <%= link_to "Olvidé mi contraseña", new_password_path, class: "hover:text-slate-600" %>
    </p>
  </div>
</div>
