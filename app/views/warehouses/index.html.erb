<% content_for :title, "Depósitos" %>
<%= render "shared/page_header", title: "Depósitos",
      actions: (policy(Warehouse).create? ? link_to("Nuevo depósito", new_warehouse_path, class: "rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700") : nil) %>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% @warehouses.each do |w| %>
    <% s = @stats[w.id] || { skus: 0, units: 0, low: 0 } %>
    <%= link_to warehouse_path(w.code), class: "rounded-xl border border-slate-200 bg-white p-4 hover:border-slate-400" do %>
      <div class="flex items-center justify-between">
        <span class="font-mono font-semibold"><%= w.code %></span>
        <% if w.virtual? %><span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">virtual</span><% end %>
        <% unless w.active? %><span class="rounded-full bg-rose-100 px-2 py-0.5 text-xs text-rose-700">inactivo</span><% end %>
      </div>
      <p class="mt-1 text-sm text-slate-600"><%= w.name %></p>
      <dl class="mt-3 grid grid-cols-3 gap-2 text-center text-xs">
        <div><dt class="text-slate-400">SKUs</dt><dd class="font-semibold"><%= s[:skus] %></dd></div>
        <div><dt class="text-slate-400">Unidades</dt><dd class="font-semibold"><%= number_with_delimiter(s[:units]) %></dd></div>
        <div><dt class="text-slate-400">Bajo mín.</dt><dd class="font-semibold <%= 'text-amber-600' if s[:low].to_i.positive? %>"><%= s[:low] %></dd></div>
      </dl>
    <% end %>
  <% end %>
</div>
