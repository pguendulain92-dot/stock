<%# El navbar. `current_page?` resalta la sección activa. %>
<nav class="border-b border-slate-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-14 items-center justify-between">
      <div class="flex items-center gap-6">
        <%= link_to root_path, class: "font-semibold tracking-tight text-slate-900" do %>
          📦 Stock
        <% end %>
        <div class="hidden items-center gap-1 md:flex">
          <% [["Panel", root_path],
              ["Productos", products_path],
              ["Existencias", stock_items_path],
              ["Movimientos", stock_movements_path],
              ["Transferencias", stock_transfers_path],
              ["Depósitos", warehouses_path],
              ["Proveedores", suppliers_path]].each do |label, path| %>
            <%= link_to label, path,
                  class: "rounded-md px-3 py-1.5 text-sm font-medium #{current_page?(path) ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100'}" %>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-3 text-sm">
        <span class="hidden text-slate-500 sm:inline"><%= current_user %></span>
        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">
          <%= current_user&.role %>
        </span>
        <%= button_to "Salir", session_path, method: :delete,
              class: "rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-50" %>
      </div>
    </div>
  </div>
</nav>
