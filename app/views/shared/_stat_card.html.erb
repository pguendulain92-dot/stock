<div class="rounded-xl border border-slate-200 bg-white p-4">
  <div class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= label %></div>
  <div class="mt-1 text-2xl font-semibold <%= local_assigns[:tone] || 'text-slate-900' %>">
    <%= value %>
  </div>
  <% if local_assigns[:hint].present? %>
    <div class="mt-1 text-xs text-slate-400"><%= hint %></div>
  <% end %>
</div>
